    {
      "parameters": {
        "jsCode": "// Get the new applicant's data from the Webhook node\nconst webhookData = $('Webhook').first().json.body;\n\n// Get the raw response from HTTP Request - GitHub serves it as plain text,\n// so we need to parse it into JSON ourselves\nconst rawResponse = $input.first().json.data;\nconst knownPeople = typeof rawResponse === 'string' ? JSON.parse(rawResponse) : rawResponse;\n\n// --- Normalize helper functions (same logic as our Python pipeline) ---\nfunction normalizePhone(raw) {\n  if (!raw) return null;\n  const digits = String(raw).replace(/\\D/g, '');\n  return digits.length >= 10 ? digits.slice(-10) : null;\n}\nfunction normalizeEmail(raw) {\n  return raw ? String(raw).trim().toLowerCase() : null;\n}\n\nconst newEmail = normalizeEmail(webhookData.email);\nconst newPhone = normalizePhone(webhookData.phone);\n\n// Check if this person already exists (same matching logic as Task 1)\nconst match = knownPeople.find(person =>\n  (newEmail && person.canonical_email === newEmail) ||\n  (newPhone && person.canonical_phone === newPhone)\n);\n\nreturn [{\n  json: {\n    submitted_name: webhookData.name,\n    submitted_email: webhookData.email,\n    submitted_phone: webhookData.phone,\n    is_duplicate: !!match,\n    matched_person: match || null,\n  }\n}];"
      },
